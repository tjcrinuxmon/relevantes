# Puerto del servicio (detrás del gateway)
PORT=3007

# Secreto para firmar el JWT propio del módulo (sesión dentro de Relevantes)
JWT_SECRET=cambia_esto_por_un_secreto_largo

# Debe coincidir EXACTAMENTE con RELEVANTES_SECRET del portal (SSO)
RELEVANTES_SSO_SECRET=cambia_esto_igual_que_en_el_portal

# Origen permitido para CORS (el gateway)
ALLOWED_ORIGIN=http://localhost:3000
